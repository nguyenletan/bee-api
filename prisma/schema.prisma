generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "tracing", "relationJoins"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL_BEE_INPUT")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model AuthType {
  id          Int     @id(map: "authtype_pk") @default(autoincrement())
  name        String? @db.VarChar
  description String?
